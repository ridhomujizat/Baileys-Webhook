# ===================
# Production Environment Template
# ===================
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# API Authentication
# IMPORTANT: Generate a strong random token (min 32 characters)
# Example: openssl rand -hex 32
TOKEN=your-secure-api-token-here

# Session Storage
SESSION_PATH=/app/sessions

# CORS Configuration
# Comma-separated list of allowed origins for production
# Leave empty to only allow same-origin requests
ALLOWED_ORIGINS=https://yourdomain.com

# Rate Limiting
# Window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP (default: 100)
RATE_LIMIT_MAX=100
